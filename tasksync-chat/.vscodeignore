# Exclude all build artifacts except the bundled extension entrypoint
dist/**
!dist/extension.js

# Exclude test coverage output
coverage/**

# Exclude dev-only tooling not needed at runtime (storybook is its own package, huge)
storybook/**
evals/**
tools/**
AskAway.code-workspace

# Include askaway resources for bundling in VSIX
!askaway-resources/**

# Team member face portraits (media/team/avatars/<memberId>.png) ship with the extension
!media/team/avatars/*.png

# Test output and caches that tests leave in the working folder (tens of thousands of files)
build/**
.webex-cache/**
test-fixtures/**
.test-fixtures/**
.*-build/**
.askaway/**
.gate.tmp
docs/screenshots/**

.story-shots/
